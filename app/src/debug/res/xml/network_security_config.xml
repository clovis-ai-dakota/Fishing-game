<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: cleartext is allowed so the game can reach a development server
    (ws://10.0.2.2:8080/battle from the emulator, or a computer on the local network). Release
    builds use src/main/res/xml/network_security_config.xml, which refuses cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Lets a debugging proxy's user-installed certificate inspect the game's HTTPS traffic. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
