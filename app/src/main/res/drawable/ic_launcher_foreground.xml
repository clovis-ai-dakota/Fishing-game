<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon, foreground layer (108 x 108, everything that matters inside the
    66-unit safe circle around the centre): the game's pale line and hook, and a round, blushing
    golden fish from the sunlit shallows, with bubbles. ic_launcher_monochrome.xml is the same
    drawing in one colour, for themed icons.
-->
