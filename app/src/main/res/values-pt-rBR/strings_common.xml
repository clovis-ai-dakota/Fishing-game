<?xml version="1.0" encoding="utf-8"?>
<!--
    Português do Brasil. Palavras e formatos usados no app inteiro: botões, unidades, números,
    listas. Chaves começam com common_.
-->
<resources>
    <!-- Botões. -->
    <string name="common_ok">OK</string>
    <string name="common_cancel">Cancelar</string>
    <string name="common_back">‹ Voltar</string>
    <string name="common_no_thanks">Não, obrigado</string>
    <string name="common_got_it">Entendi</string>

    <!-- Unidades. -->
    <string name="common_meters">%1$s m</string>
    <string name="common_kg">%1$s kg</string>
    <string name="common_meters_per_second">%1$s m/s</string>
    <string name="common_points">%1$s pts</string>
    <string name="common_points_plus">+%1$s pts</string>
    <string name="common_points_stacked">%1$s\npts</string>
    <string name="common_time_on_the_hour">%1$02d:00</string>
    <!-- Durações. -->
    <plurals name="common_days">
        <item quantity="one">%d dia</item>
        <item quantity="many">%d de dias</item>
        <item quantity="other">%d dias</item>
    </plurals>
    <plurals name="common_hours">
        <item quantity="one">%d hora</item>
        <item quantity="many">%d de horas</item>
        <item quantity="other">%d horas</item>
    </plurals>
    <plurals name="common_weeks">
        <item quantity="one">%d semana</item>
        <item quantity="many">%d de semanas</item>
        <item quantity="other">%d semanas</item>
    </plurals>
    <plurals name="common_lanterns">
        <item quantity="one">%d Lanterna</item>
        <item quantity="many">%d de Lanternas</item>
        <item quantity="other">%d Lanternas</item>
    </plurals>
    <string name="common_duration_minutes">%1$d min</string>
    <string name="common_duration_hours">%1$d h</string>
    <string name="common_duration_hours_minutes">%1$d h %2$d min</string>
    <string name="common_duration_days_hours">%1$d d %2$d h</string>
    <!-- Números compactos: "5 mil", "1,5 mi". -->
    <string name="common_compact_thousands">%1$s mil</string>
    <string name="common_compact_millions">%1$s mi</string>
    <string name="common_progress_of">%1$s / %2$s</string>

    <!-- Listas: "a, b e c". -->
    <string name="common_list_middle">%1$s, %2$s</string>
    <string name="common_list_end">%1$s e %2$s</string>
</resources>
