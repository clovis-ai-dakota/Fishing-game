<?xml version="1.0" encoding="utf-8"?>
<!--
    La Tienda: mensajes tras una compra, un regalo o un guardado en la nube (GameViewModel), lo que
    da cada artículo (ShopText), errores de cuenta (AccountClient) y las pantallas de la Tienda
