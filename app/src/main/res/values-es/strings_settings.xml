    empiezan por settings_<sección>_.
-->
<resources>
    <string name="settings_title">Ajustes</string>
    <string name="settings_version">Deep Line %1$s</string>

    <!-- Help section. -->
    <string name="settings_help_title">Ayuda</string>
    <string name="settings_help_body">La guía explica cómo se juega y para qué sirve cada cosa.</string>
    <string name="settings_help_tour">Ver la guía</string>

