<!--
    La pestaña Dex (ui/dex/): las cartas de las especies, la página de cada especie y la sección
    Aspectos. "Dex" es un nombre inventado: se mantiene. Las claves empiezan por dex_.
-->
<resources>
    <!-- The Dex tab's header. -->
    <plurals name="dex_subtitle">
        <item quantity="one">%d especie por descubrir en las profundidades</item>
        <item quantity="many">%d de especies por descubrir en las profundidades</item>
        <item quantity="other">%d especies por descubrir en las profundidades</item>
    </plurals>
