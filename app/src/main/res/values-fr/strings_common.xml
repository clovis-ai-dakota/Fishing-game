<?xml version="1.0" encoding="utf-8"?>
<!--
    Mots et formats utilisés dans toute l'application : boutons, unités, nombres, listes.
    (Words and formats used all over the app: buttons, units, numbers, lists.)
-->
<resources>
    <!-- Buttons. -->
    <string name="common_ok">OK</string>
    <string name="common_cancel">Annuler</string>
    <string name="common_back">‹ Retour</string>
    <string name="common_no_thanks">Non merci</string>
    <string name="common_got_it">Compris</string>

    <!-- Units. -->
    <string name="common_meters">%1$s m</string>
    <string name="common_kg">%1$s kg</string>
    <string name="common_meters_per_second">%1$s m/s</string>
    <string name="common_points">%1$s pts</string>
    <string name="common_points_plus">+%1$s pts</string>
    <string name="common_points_stacked">%1$s\npts</string>
    <!-- French writes hours as "21 h". -->
    <string name="common_time_on_the_hour">%1$d h</string>
    <!-- Durations. -->
    <plurals name="common_days">
        <item quantity="one">%d jour</item>
        <item quantity="many">%d jours</item>
        <item quantity="other">%d jours</item>
    </plurals>
    <plurals name="common_hours">
        <item quantity="one">%d heure</item>
        <item quantity="many">%d heures</item>
        <item quantity="other">%d heures</item>
    </plurals>
    <plurals name="common_weeks">
        <item quantity="one">%d semaine</item>
        <item quantity="many">%d semaines</item>
        <item quantity="other">%d semaines</item>
    </plurals>
    <plurals name="common_lanterns">
        <item quantity="one">%d Lanterne</item>
        <item quantity="many">%d de Lanternes</item>
        <item quantity="other">%d Lanternes</item>
    </plurals>
    <!-- j = jours, h = heures, min = minutes. -->
    <string name="common_duration_minutes">%1$d min</string>
    <string name="common_duration_hours">%1$d h</string>
    <string name="common_duration_hours_minutes">%1$d h %2$d min</string>
    <string name="common_duration_days_hours">%1$d j %2$d h</string>
    <string name="common_compact_thousands">%1$s k</string>
    <string name="common_compact_millions">%1$s M</string>
    <string name="common_progress_of">%1$s / %2$s</string>

    <!-- Lists: "a, b et c". -->
    <string name="common_list_middle">%1$s, %2$s</string>
    <string name="common_list_end">%1$s et %2$s</string>
</resources>
